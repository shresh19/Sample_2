  width: 0.8rem;
  height: 0.8rem;
  color: var(--color-primary);
  flex-shrink: 0;
}
.statusRow span {
  font-weight: 500;
  color: var(--color-primary-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.batchTotal {
  font-weight: 700;
  color: var(--color-success);
}

.employeeList {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1rem;
  max-height: 20rem;
  overflow-y: auto;
  padding-right: 0.5rem;
}

.employeeChip {
  padding: 0.75rem;
  background-color: var(--color-primary-light);
  border-radius: var(--radius);
  border: 1px solid var(--color-border-input);
}

.employeeHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-primary-text);
  margin-bottom: 0.25rem;
  gap: 0.5rem; 
}

.employeeHeader-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
}

.employeeSalary {
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--color-success);
  background-color: var(--color-success-light);
  padding: 0.1rem 0.4rem;
  border-radius: var(--radius-sm);
}

.unassignButton {
  background: none;
  border: none;
  color: var(--color-danger);
  opacity: 0.6;
  cursor: pointer;
  padding: 0.1rem;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}
.unassignButton:hover {
  opacity: 1;
  background-color: #fee2e2; /* red-100 */
}
.unassignButton svg {
  width: 1rem;
  height: 1rem;
  margin: 0;
}


.employeeDetails {
  font-size: 0.75rem;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.employeeDetails p {
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.employeeDetails b {
  color: var(--color-text-primary);
}


.noEmployeesText {
  color: var(--color-text-light);
  font-style: italic;
  font-size: 0.9rem;
  padding: 0.5rem;
  background-color: var(--color-bg-muted);
  border-radius: var(--radius);
}

.cardFooter {
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border-light);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

@media (min-width: 768px) {
  .batchGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1100px) {
  .batchGrid {
    grid-template-columns: repeat(3, 1fr);
  }
}
