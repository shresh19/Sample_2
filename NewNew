package paymentinitiationbackend.controller;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.tags.Tag;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

// We can reuse the DTO, but a dedicated one is cleaner.
// For simplicity, we'll reuse ApprovalRequestDto as requested by its structure.
import paymentinitiationbackend.dto.ApprovalRequestDto; 
import paymentinitiationbackend.model.Approver;
import paymentinitiationbackend.repository.ApproverRepository;

import java.util.Optional;

@RestController
@RequestMapping("/api/auth")
@Tag(name = "Authentication", description = "APIs for approver registration and login")
public class AuthController {

    private final ApproverRepository approverRepository;

    @Autowired
    public AuthController(ApproverRepository approverRepository) {
        this.approverRepository = approverRepository;
    }

    /**
     * API 1: Register a new approver.
     * Use this from Swagger or Postman to add users to the 'approvers' table.
     * It uses the ApprovalRequestDto fields:
     * - approverName -> userId
     * - password -> password
     */
    @PostMapping("/register")
    @Operation(summary = "Register a new approver", description = "Creates a new approver user with a user ID and password. (For internal/setup use)")
    @ApiResponse(responseCode = "201", description = "Approver registered successfully")
    @ApiResponse(responseCode = "400", description = "User ID already exists")
    public ResponseEntity<String> registerApprover(@RequestBody ApprovalRequestDto request) {
        // Check if user already exists
        if (approverRepository.findByUserId(request.getApproverName()).isPresent()) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("User ID already exists");
        }
        
        // We reuse ApprovalRequestDto: approverName -> userId, password -> password
        Approver newApprover = new Approver();
        newApprover.setUserId(request.getApproverName());
        newApprover.setPassword(request.getPassword()); // In a real app, HASH this
        approverRepository.save(newApprover);
        
        return ResponseEntity.status(HttpStatus.CREATED).body("Approver registered successfully");
    }

    /**
     * API 2: Authenticate an approver (login).
     * The frontend will call this API from the modal.
     */
    @PostMapping("/login")
    @Operation(summary = "Authenticate an approver", description = "Verifies an approver's user ID and password")
    @ApiResponse(responseCode = "200", description = "Authentication successful")
    @ApiResponse(responseCode = "401", description = "Invalid credentials")
    public ResponseEntity<String> loginApprover(@RequestBody ApprovalRequestDto request) {
        Optional<Approver> approverOpt = approverRepository.findByUserId(request.getApproverName());

        if (approverOpt.isEmpty()) {
            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Invalid credentials");
        }

        Approver approver = approverOpt.get();
        // Plain text password check as requested.
        if (approver.getPassword().equals(request.getPassword())) {
            return ResponseEntity.ok("Authentication successful");
        } else {
            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Invalid credentials");
        }
    }
}


