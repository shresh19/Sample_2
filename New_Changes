    @PutMapping("/{id}/approve")
    @Transactional
    @Operation(summary = "Approve a batch", description = "Approve a pending batch. Handles L1 and L2 logic.")
    @ApiResponses(value = {
            @ApiResponse(responseCode = "200", description = "Batch approved successfully (L1 or L2)"),
            @ApiResponse(responseCode = "400", description = "Invalid request or batch not pending"),
            @ApiResponse(responseCode = "403", description = "Forbidden. Same user cannot approve twice."),
            @ApiResponse(responseCode = "404", description = "Batch or Account not found"),
            @ApiResponse(responseCode = "409", description = "Insufficient funds"),
            @ApiResponse(responseCode = "500", description = "Internal server error")
    })
    public ResponseEntity<ApprovalBatchDto> approveBatch(
            @Parameter(description = "Batch ID", required = true) @PathVariable Long id,
            @RequestBody ApprovalRequestDto approvalRequest) {
        
        // Authentication is now handled by /api/auth/login
        // The password in approvalRequest is no longer used here.
        
        try {
            Batch batch = batchRepository.findById(id).orElse(null);
            if (batch == null) return ResponseEntity.notFound().build();

            String currentStatus = batch.getPaymentStatus();
            String approverName = approvalRequest.getApproverName();

            // Check if batch is in a valid state to be approved
            if (currentStatus == null ||
                    (!currentStatus.equalsIgnoreCase("Pending") && !currentStatus.equalsIgnoreCase("Pending_L2"))) {
                return ResponseEntity.status(HttpStatus.BAD_REQUEST).build(); // Already approved/rejected
            }

            // Calculate total amount
            List<Employee> emps = employeeRepository.findByBatchId(id);
            BigDecimal total = emps.stream()
                    .map(Employee::getSalaryAmount)
                    .filter(Objects::nonNull)
                    .reduce(BigDecimal.ZERO, BigDecimal::add);

            boolean requiresDualApproval = total.compareTo(DUAL_APPROVAL_THRESHOLD) > 0;
            boolean isL1Approval = currentStatus.equalsIgnoreCase("Pending");
            boolean isL2Approval = currentStatus.equalsIgnoreCase("Pending_L2");

            // --- DUAL-APPROVAL LOGIC ---
            if (requiresDualApproval) {
                if (isL1Approval) {
                    // This is the first approval for a high-value batch
                    batch.setPaymentStatus("Pending_L2"); // Move to L2 pending state
                    batch.setApprover1Name(approverName);
                    // Do NOT debit account yet
                    batchRepository.save(batch);
                } else if (isL2Approval) {
                    // This is the second approval
                    // Check if approver is different
                    if (approverName.equalsIgnoreCase(batch.getApprover1Name())) {
                        return ResponseEntity.status(HttpStatus.FORBIDDEN).build(); // Same user
                    }
                    // All checks passed, proceed to debit and approve
                    debitAccountAndSetRefs(batch, emps, total); // <-- Helper function
                    batch.setPaymentStatus("approved");
                    batch.setApprover2Name(approverName);
                    batch.setLastPaymentDate(java.time.LocalDateTime.now());
                    batchRepository.save(batch);
                }
            } else {
                // --- SINGLE-APPROVAL LOGIC ---
                if (isL1Approval) {
                    // Standard approval, debit and approve
                    debitAccountAndSetRefs(batch, emps, total); // <-- Helper function
                    batch.setPaymentStatus("approved");
                    batch.setApprover1Name(approverName); // Store the single approver
                    batch.setLastPaymentDate(java.time.LocalDateTime.now());
                    batchRepository.save(batch);
                } else {
                    // Should not happen (e.g., L2 status for low-value batch)
                    return ResponseEntity.status(HttpStatus.BAD_REQUEST).build();
                }
            }

            // Map and return the updated DTO
            ApprovalBatchDto dto = mapBatchToApprovalDto(batch);
            dto.setApprovedBy(approverName); // Set 'approvedBy' to the *current* approver
            dto.setApprovedDate(java.time.LocalDateTime.now());
            dto.setApprovalComments(approvalRequest.getComments());
            
            return ResponseEntity.ok(dto);

        } catch (InsufficientFundsException e) {
             return ResponseEntity.status(HttpStatus.CONFLICT).build(); // 409 Conflict
        } catch (BankAccountNotFoundException e) {
             return ResponseEntity.status(HttpStatus.NOT_FOUND).build(); // 404 Not Found
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
        }
    }

    /**
     * Helper method to debit account and assign transaction references.
     * Throws custom exceptions to be caught by the controller.
     */
    private void debitAccountAndSetRefs(Batch batch, List<Employee> emps, BigDecimal total) 
            throws BankAccountNotFoundException, InsufficientFundsException {
        
        String accNum = batch.getDebitAccount();
        if (accNum == null || accNum.isBlank()) {
            throw new BankAccountNotFoundException(); // Or use 400 Bad Request in controller
        }
        
        BankAccount acct = bankAccountRepository.findByAccountNumber(accNum)
                .orElseThrow(BankAccountNotFoundException::new);

        if (acct.getBalance().compareTo(total) < 0) {
            throw new InsufficientFundsException();
        }
        
        // Debit account
        acct.setBalance(acct.getBalance().subtract(total));
        bankAccountRepository.save(acct);

        // Set payment references for employees
        for (Employee e : emps) {
            if (e.getPaymentRef() == null || e.getPaymentRef().isBlank()) {
                String token = "TRX-" + batch.getId() + "-" + UUID.randomUUID().toString().replace("-", "").substring(0, 8).toUpperCase();
                e.setPaymentRef(token);
            }
        }
        employeeRepository.saveAll(emps);
    }

    // Custom exceptions for helper
    private static class BankAccountNotFoundException extends RuntimeException {}
    private static class InsufficientFundsException extends RuntimeException {}


    @PutMapping("/{id}/reject")
    @Operation(summary = "Reject a batch", description = "Reject a pending batch (L1 or L2)")
    @ApiResponses(value = {
            @ApiResponse(responseCode = "200", description = "Batch rejected successfully"),
            @ApiResponse(responseCode = "400", description = "Invalid request or batch not pending"),
            @ApiResponse(responseCode = "404", description = "Batch not found"),
            @ApiResponse(responseCode = "500", description = "Internal server error")
    })
    public ResponseEntity<ApprovalBatchDto> rejectBatch(
            @Parameter(description = "Batch ID", required = true) @PathVariable Long id,
            @RequestBody ApprovalRequestDto approvalRequest) {
        
        // Authentication is now handled by /api/auth/login
        
        try {
            Batch batch = batchRepository.findById(id).orElse(null);
            if (batch == null) return ResponseEntity.notFound().build();

            String currentStatus = batch.getPaymentStatus();

            // Check if batch is in a valid state to be rejected
            if (currentStatus == null ||
                    (!currentStatus.equalsIgnoreCase("Pending") && !currentStatus.equalsIgnoreCase("Pending_L2"))) {
                return ResponseEntity.status(HttpStatus.BAD_REQUEST).build(); // Already approved/rejected
            }
            
            // Rejection at any stage (L1 or L2) moves to "rejected"
            batch.setPaymentStatus("rejected");
            batch.setLastPaymentDate(java.time.LocalDateTime.now());
            // Store the person who rejected it
            batch.setApprover1Name(approvalRequest.getApproverName()); 
            batchRepository.save(batch);

            ApprovalBatchDto dto = mapBatchToApprovalDto(batch);
            dto.setApprovedBy(approvalRequest.getApproverName()); // 'approvedBy' field is used for 'rejectedBy'
            dto.setApprovedDate(java.time.LocalDateTime.now());
            dto.setApprovalComments(approvalRequest.getComments());
            
            return ResponseEntity.ok(dto);
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
        }
    }

    /**
     * THIS METHOD IS HEAVILY UPDATED
     * It now populates the new DTO fields for the frontend.
     */
    private ApprovalBatchDto mapBatchToApprovalDto(Batch batch) {
        java.util.List<Employee> emps = employeeRepository.findByBatchId(batch.getId());
        java.math.BigDecimal total = emps.stream()
                .map(Employee::getSalaryAmount)
                .filter(java.util.Objects::nonNull)
                .reduce(java.math.BigDecimal.ZERO, java.math.BigDecimal::add);
        
        ApprovalBatchDto dto = new ApprovalBatchDto();
        dto.setId(batch.getId());
        dto.setBatchName(batch.getName());
        dto.setCreatedBy("Unknown"); // You should set this from the Batch entity if it exists
        dto.setCreatedDate(java.time.LocalDateTime.now()); // You should set this from the Batch entity
        
        String status = batch.getPaymentStatus() != null ? batch.getPaymentStatus().toLowerCase() : "pending";
        dto.setStatus(status);
        
        dto.setTotalAmount(total);
        dto.setCurrency(batch.getCurrency());
        dto.setEmployeeCount(emps.size());
        dto.setDebitAccount(batch.getDebitAccount());
        dto.setDescription(null); // Set from Batch entity if it exists

        // --- NEW DUAL-APPROVAL DTO LOGIC ---
        boolean requiresDual = total.compareTo(DUAL_APPROVAL_THRESHOLD) > 0;
        
        dto.setApprovalsRequired(requiresDual ? 2 : 1);
        
        if (status.equals("pending_l2")) {
            dto.setApprovalsReceived(1);
        } else if (status.equals("approved") || status.equals("rejected")) {
            dto.setApprovalsReceived(dto.getApprovalsRequired()); // Or based on approver fields
        } else {
            dto.setApprovalsReceived(0);
        }
        
        dto.setApprover1Name(batch.getApprover1Name());
        
        // Note: 'approvedBy' and 'approvedDate' are set by the caller (approve/reject methods)
        // as they relate to the *last action* taken.
        
        return dto;
    }

