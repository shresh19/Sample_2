// Assuming this file is at: src/services/ApprovalService.js
// Adjust API_BASE_URL if your backend is on a different port/domain
const API_BASE_URL = '/api';

/**
 * Helper to handle fetch responses
 */
const handleResponse = async (response) => {
    if (!response.ok) {
        const errorText = await response.text();
        throw new Error(errorText || `Request failed with status ${response.status}`);
    }
    return response.json();
};

/**
 * Authenticates an approver using the new auth endpoint.
 * Throws an error if authentication fails.
 */
const login = async (userId, password) => {
    const response = await fetch(`${API_BASE_URL}/auth/login`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            approverName: userId, // Map to the DTO field
            password: password
        }),
    });

    if (!response.ok) {
        const errorText = await response.text();
        throw new Error(errorText || 'Authentication failed');
    }

    return await response.text(); // Returns "Authentication successful"
};

/**
 * Fetches all pending (L1 and L2) batches
 */
const getPendingBatches = async () => {
    const response = await fetch(`${API_BASE_URL}/approvals/pending`);
    return handleResponse(response);
};

/**
 * Fetches all reviewed (approved/rejected) batches
 */
const getReviewedBatches = async () => {
    const response = await fetch(`${API_BASE_URL}/approvals/reviewed`);
    return handleResponse(response);
};

/**
 * Approves a batch (L1 or L2)
 * Updated to return the JSON response
 */
const approveBatch = async (batchId, approvalData) => {
    const response = await fetch(`${API_BASE_URL}/approvals/${batchId}/approve`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(approvalData), // DTO without password
    });
    return handleResponse(response); // Returns updated batch DTO
};

/**
 * Rejects a batch
 * Updated to return the JSON response
 */
const rejectBatch = async (batchId, approvalData) => {
    const response = await fetch(`${API_BASE_URL}/approvals/${batchId}/reject`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(approvalData), // DTO without password
    });
    return handleResponse(response); // Returns updated batch DTO
};

/**
 * Transforms raw API batch data into the format expected by the frontend components.
 * This is based on the DTO fields.
 */
const transformBatchData = (batch) => {
    return {
        id: batch.id,
        batchId: batch.id, // Use 'id' as batchId for consistency
        batchName: batch.batchName,
        createdBy: batch.createdBy || 'Unknown',
        createdDate: batch.createdDate || new Date().toISOString(),
        status: batch.status, // "pending", "pending_l2", "approved", "rejected"
        totalAmount: batch.totalAmount,
        currency: batch.currency,
        employeeCount: batch.employeeCount,
        approversRequired: batch.approvalsRequired || 1,
        approversAssigned: batch.approvalsReceived || 0,
        debitAccount: batch.debitAccount,
        description: batch.description,
        approvedBy: batch.approvedBy,
        approvedDate: batch.approvedDate,
        approvalComments: batch.approvalComments,
        approver1Name: batch.approver1Name,
    };
};

const ApprovalService = {
    login,
    getPendingBatches,
    getReviewedBatches,
    approveBatch,
    rejectBatch,
    transformBatchData
};

export default ApprovalService;
