import { getEmployees } from '../../services/api';

const ApproverPage = () => {
    const [payrolls, setPayrolls] = useState([]);
    const [selectedPayroll, setSelectedPayroll] = useState(null);
    const [showDetailsModal, setShowDetailsModal] = useState(false);
    const [isLoading, setIsLoading] = useState(false);
    const [allEmployees, setAllEmployees] = useState([]);
    const [searchId, setSearchId] = useState('');
    const [showAuthModal, setShowAuthModal] = useState(false);

    // --- NEW/MODIFIED STATE for Auth ---
    const [authUserId, setAuthUserId] = useState('');
    const [authPassword, setAuthPassword] = useState('');
    const [pendingAction, setPendingAction] = useState(null);
    const [authError, setAuthError] = useState('');
    const [authLoading, setAuthLoading] = useState(false); // Auth-specific loading

    // Load pending payrolls from API
    const loadPendingBatches = async () => {
        setIsLoading(true);
        try {
            const apiBatches = await ApprovalService.getPendingBatches();
            const transformedBatches = apiBatches
                .map(ApprovalService.transformBatchData)
                .filter(b => (b.debitAccount && String(b.debitAccount).trim() !== '') && (b.currency && String(b.currency).trim() !== ''));
            setPayrolls(transformedBatches);

            // Load employees if not already loaded or if needed
            if (allEmployees.length === 0) {
                try {
                    const employees = await getEmployees();
                    setAllEmployees(Array.isArray(employees) ? employees : []);
                } catch (empErr) {
                    console.error('Error loading employees:', empErr);
                    setAllEmployees([]);
                }
            }
        } catch (error) {
            console.error('Error loading pending batches:', error);
            setPayrolls([]);
        } finally {
            setIsLoading(false);
        }
    };

    useEffect(() => {
        loadPendingBatches();
    }, []); // Removed allEmployees from dependency array to prevent re-fetch

    const handleViewDetails = (payroll) => {
        setSelectedPayroll(payroll);
        setShowDetailsModal(true);
    };

    const handleCloseModal = () => {
        setShowDetailsModal(false);
        setSelectedPayroll(null);
    };

    const handleAuthPrompt = (action, payrollId) => {
        setPendingAction({ action, payrollId });
        setShowAuthModal(true);
        setAuthUserId(''); // Clear fields on open
        setAuthPassword('');
        setAuthError('');
    };

    const handleAuthSubmit = async () => {
        setAuthLoading(true);
        setAuthError('');

        try {
            // Step 1: Authenticate using the new service
            await ApprovalService.login(authUserId, authPassword);

            // Step 2: Auth success, close modal and proceed with action
            setShowAuthModal(false);

            const comments = prompt(
                `Please enter optional comments for this ${pendingAction.action}:`,
                pendingAction.action === 'approve' ? 'Approved' : 'Rejected'
            );

            // User pressed cancel on the comment prompt
            if (comments === null) {
                setAuthLoading(false);
                setPendingAction(null);
                return; 
            }

            const approvalDetails = {
                approverName: authUserId, // Use the authenticated User ID
                comments: comments || (pendingAction.action === 'approve' ? 'Approved' : 'Rejected')
            };

            if (pendingAction.action === 'approve') {
                await handleApprove(pendingAction.payrollId, approvalDetails);
            } else if (pendingAction.action === 'reject') {
                await handleReject(pendingAction.payrollId, approvalDetails);
            }

            setPendingAction(null);

        } catch (error) {
            console.error('Authentication or action failed:', error);
            setAuthError(error.message || 'Invalid User ID or Password.');
        } finally {
            setAuthLoading(false);
        }
    };

    const handleAuthCancel = () => {
        setShowAuthModal(false);
        setPendingAction(null);
        setAuthPassword('');
        setAuthUserId('');
        setAuthError('');
    };

    // MODIFIED: This function now re-fetches the list on success
    const handleApprove = async (payrollId, approvalDetails) => {
        setIsLoading(true); // Use main page loader

        try {
            const item = payrolls.find(p => p.id === payrollId);
            const batchId = item?.batchId || item?.id;

            const approvalData = {
                approverName: approvalDetails.approverName,
                comments: approvalDetails.comments
                // No password is sent here
            };

            // API call now returns the updated batch DTO
            const updatedBatch = await ApprovalService.approveBatch(batchId, approvalData);

            // Close modal if open
            if (showDetailsModal) {
                handleCloseModal();
            }

            // Show success message based on outcome
            if (updatedBatch.status === 'pending_l2') {
                alert('Batch approved for L1. Now pending L2 approval.');
            } else if (updatedBatch.status === 'approved') {
                alert('Payroll batch approved successfully!');
            }

            // REFRESH the entire list to show new status (L1 -> L2)
            await loadPendingBatches();
            
            try {
                window.dispatchEvent(new Event('approvals:updated'));
            } catch (_) { }

        } catch (error) {
            console.error('Error approving batch:', error);
            alert(`Error approving batch: ${error.message}`);
            setIsLoading(false); // Only stop loading on error
        }
        // setIsLoading(false) is handled by loadPendingBatches()
    };

    // MODIFIED: This function also re-fetches the list
    const handleReject = async (payrollId, approvalDetails) => {
        setIsLoading(true);

        try {
            const item = payrolls.find(p => p.id === payrollId);
            const batchId = item?.batchId || item?.id;

            const approvalData = {
                approverName: approvalDetails.approverName,
                comments: approvalDetails.comments
            };

            await ApprovalService.rejectBatch(batchId, approvalData);

            // Close modal if open
            if (showDetailsModal) {
                handleCloseModal();
            }

            alert('Payroll batch rejected successfully!');

            // REFRESH the entire list to remove the rejected item
            await loadPendingBatches();

            try {
                window.dispatchEvent(new Event('approvals:updated'));
            } catch (_) { }

        } catch (error) {
            console.error('Error rejecting batch:', error);
            alert(`Error rejecting batch: ${error.message}`);
            setIsLoading(false); // Only stop loading on error
        }
        // setIsLoading(false) is handled by loadPendingBatches()
    };

    // Filter logic remains the same
    const pendingPayrolls = payrolls.filter(payroll => {
        const isPending = payroll.status === 'pending' || payroll.status === 'pending_l2'; // Updated
        const matchesSearch = searchId === '' || payroll.id.toLowerCase().includes(searchId.toLowerCase());
        return isPending && matchesSearch;
    }).sort((a, b) => new Date(a.createdDate) - new Date(b.createdDate));

    return (
        <div className="approver-page">
            <div className="container">
                {/* Header */}
                <div className="page-header">
                    <h1 className="page-title">Payroll Approval Dashboard</h1>
                    <p className="page-subtitle">
                        Review and approve pending payroll batches
                    </p>
                </div>

                {/* Statistics (This will correctly reflect pending L1 + L2) */}
                <div className="stats-section">
                    <div className="stat-card">
                        <div className="stat-icon pending"></div>
                        <div className="stat-content">
                            <div className="stat-value">{pendingPayrolls.length}</div>
                            <div className="stat-label">Pending Approvals</div>
                        </div>
                    </div>
                    {/* ... other stat cards ... */}
                </div>

                {/* Search Bar */}
                {/* ... (search bar JSX remains the same) ... */}

                {/* Payroll Cards */}
                <div className="payrolls-section">
                    <div className="section-header">
                        <h2 className="section-title">Pending Payroll Batches</h2>
                        <div className="section-count">
                            {pendingPayrolls.length} batch{pendingPayrolls.length !== 1 ? 'es' : ''} pending
                        </div>
                    </div>

                    {pendingPayrolls.length === 0 ? (
                        <div className="empty-state">
                            {/* ... (empty state JSX remains the same) ... */}
                        </div>
                    ) : (
                        <div className="payrolls-grid">
                            {pendingPayrolls.map(payroll => (
                                <PayrollCard
                                    key={payroll.id}
                                    payroll={payroll}
                                    onViewDetails={handleViewDetails}
                                    onApprove={(id) => handleAuthPrompt('approve', id)}
                                    onReject={(id) => handleAuthPrompt('reject', id)}
                                    isLoading={isLoading} // Use main loader
                                />
                            ))}
                        </div>
                    )}
                </div>

                {/* Details Modal */}
                {showDetailsModal && (
                    <PayrollDetailsModal
                        payroll={selectedPayroll}
                        employees={allEmployees.filter(e => String(e.batchId || '') === String(selectedPayroll?.id || ''))}
                        onClose={handleCloseModal}
                        onApprove={(id) => handleAuthPrompt('approve', id)}
                        onReject={(id) => handleAuthPrompt('reject', id)}
                        isLoading={isLoading} // Use main loader
                    />
                )}

                {/* --- MODIFIED: Authentication Modal --- */}
                {showAuthModal && (
                    <div className="modal-overlay">
                        <div className="modal">
                            <div className="modal-header">
                                <h3 className="modal-title">Authentication Required</h3>
                                <button className="modal-close" onClick={handleAuthCancel}>×</button>
                            </div>
                            <div className="modal-body">
                                <p>Please enter your credentials to {pendingAction?.action} this payroll batch:</p>
                                
                                <div className="form-group">
                                    <label className="form-label">User ID</label>
                                    <input
                                        type="text"
                                        className="form-input"
                                        value={authUserId}
                                        onChange={(e) => setAuthUserId(e.target.value)}
                                        placeholder="Enter your User ID"
                                        autoFocus
                                    />
                                </div>
                                
                                <div className="form-group">
                                    <label className="form-label">Password</label>
                                    <input
                                        type="password"
                                        className="form-input"
                                        value={authPassword}
                                        onChange={(e) => setAuthPassword(e.target.value)}
                                        placeholder="Enter your password"
                                    />
                                </div>

                                {authError && (
                                    <div style={{ color: '#ef4444', fontSize: '14px', marginTop: '8px' }}>
                                        {authError}
                                    </div>
                                )}
                            </div>
                            <div className="modal-footer">
                                <button className="btn btn-outline" onClick={handleAuthCancel} disabled={authLoading}>
                                    Cancel
                                </button>
                                <button
                                    className="btn btn-primary"
                                    onClick={handleAuthSubmit}
                                    disabled={!authUserId.trim() || !authPassword.trim() || authLoading}
                                >
                                    {authLoading ? 'Authenticating...' : (pendingAction?.action === 'approve' ? 'Authenticate & Approve' : 'Authenticate & Reject')}
                                </button>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

export default ApproverPage;



