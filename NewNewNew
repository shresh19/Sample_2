// Import the new apiFetch function
import { apiFetch } from './api';

/**
 * Helper to process the response from apiFetch
 */
const processResponse = async (response) => {
    // apiFetch already handles 401, but we handle other errors
    if (!response.ok) {
        const errorText = await response.text();
        throw new Error(errorText || `Request failed with status ${response.status}`);
    }
    // Try parsing JSON, but return text if it's not JSON
    // This is needed for the "Authentication successful" string response
    const text = await response.text();
    try {
        return JSON.parse(text);
    } catch (e) {
        return text; 
    }
};

/**
 * Authenticates an approver (step-up auth for the modal)
 * Path: POST /api/approve/login
 */
const login = async (userId, password) => {
    // Uses apiFetch, will send token if it exists
    const response = await apiFetch(`/api/approve/login`, {
        method: 'POST',
        body: JSON.stringify({
            approverName: userId,
            password: password
        }),
    });
    return processResponse(response);
};

/**
 * Fetches all pending batches
 * Path: GET /api/approvals/pending
 */
const getPendingBatches = async () => {
    // Uses apiFetch, will send token
    const response = await apiFetch(`/api/approvals/pending`);
    return processResponse(response);
};

/**
 * Fetches all reviewed batches
 * Path: GET /api/approvals/reviewed
 */
const getReviewedBatches = async () => {
    // Uses apiFetch, will send token
    const response = await apiFetch(`/api/approvals/reviewed`);
    return processResponse(response);
};

/**
 * Approves a batch.
 * Path: PUT /api/approvals/{id}/approve
 */
